{
  "name": "@getcontrolroom/sdk-ts",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Control Room API",
  "author": "Clover Labs <hello@getcontrolroom.com>",
  "license": "MIT",
  "homepage": "https://getcontrolroom.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/getcontrolroom/sdk-ts"
  },
  "bugs": {
    "url": "https://github.com/getcontrolroom/sdk-ts/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts"
  },
  "scripts": {
    "generate": "openapi-ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target browser"
  },
  "dependencies": {
    "@hey-api/client-fetch": "0.9.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.73.0",
    "@types/bun": "1.2.13",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
